{
  "name": "phantom-ops-v0",
  "private": true,
  "version": "0.1.0",
  "description": "Phantom OPS v0 prototype: Fly view on live Veronte 1x telemetry via Veronte Link",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c cyan,magenta \"npm:bridge\" \"npm:web\"",
    "bridge": "tsx watch bridge/main.ts",
    "web": "vite",
    "build": "tsc -b && vite build",
    "start": "concurrently -k -n bridge,web \"tsx bridge/main.ts\" \"vite preview --port 5173\"",
    "typecheck": "tsc -b",
    "test": "tsx --test bridge/*.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.1.0",
    "@protomaps/basemaps": "^5.7.2",
    "fast-xml-parser": "^5.0.0",
    "maplibre-gl": "^6.0.0",
    "pmtiles": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
